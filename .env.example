# ── Frontend (exposed to the browser — public values only) ─────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server-side only (Vercel project env vars; NEVER prefix with VITE_) ────────
# Chat support: used by /api/chat and /api/admin-assist

# anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional. Defaults: anthropic=claude-haiku-5-5, openai=gpt-4o-mini, gemini=gemini-2.0-flash
AI_MODEL=
# Max AI chat messages per user per minute / per day (defaults 6 / 100)
AI_RATE_LIMIT_PER_MIN=6
AI_RATE_LIMIT_PER_DAY=100

# Supabase service-role key (Project Settings > API). Lets the server save bot
# replies. Bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the server falls back to the VITE_ values above when these are unset
SUPABASE_URL=
SUPABASE_ANON_KEY=
